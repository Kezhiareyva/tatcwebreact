# Shared local-development defaults (Laragon or XAMPP)
# Copy this file to backend/.env. Do not commit your local .env.

PORT=3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Laragon and XAMPP normally expose MySQL at 127.0.0.1:3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tatc_web
DB_USER=root
DB_PASSWORD=
DATABASE_URL="mysql://root:@127.0.0.1:3306/tatc_web"

# Create a unique local value; never commit a real secret.
SESSION_SECRET=replace-with-a-unique-local-secret
