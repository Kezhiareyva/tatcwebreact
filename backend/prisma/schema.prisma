generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                        BigInt                      @id @default(autoincrement())
  email                     String                      @unique(map: "uq_users_email") @db.VarChar(255)
  password_hash             String                      @db.VarChar(255)
  role                      String?                     @default("PESERTA") @db.VarChar(50)
  status                    String                      @default("ACTIVE") @db.VarChar(20)
  email_verified_at         DateTime?                   @db.DateTime(0)
  verification_token        String?                     @db.VarChar(255)
  last_login_at             DateTime?                   @db.DateTime(0)
  created_at                DateTime                    @default(now()) @db.DateTime(0)
  updated_at                DateTime                    @default(now()) @updatedAt @db.DateTime(0)
  reset_token               String?                     @db.VarChar(255)
  failed_login_attempts     Int?                        @default(0)
  lockout_until             DateTime?                   @db.DateTime(0)
  name                      String?                     @db.VarChar(255)
  reset_token_expires_at    DateTime?                   @db.DateTime(0)
  recorded_attendances      Attendance[]
  audit_logs                AuditLog[]
  import_logs               ImportLog[]
  instructors               Instructor[]
  notifications             Notification[]
  participant_registrations participant_registrations[]
  user_roles                UserRole[]

  @@map("users")
}

model Role {
  id               BigInt           @id @default(autoincrement())
  code             String           @unique(map: "uq_roles_code") @db.VarChar(50)
  name             String           @db.VarChar(100)
  role_permissions RolePermission[]
  user_roles       UserRole[]

  @@map("roles")
}

model UserRole {
  user_id BigInt
  role_id BigInt
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade, map: "fk_user_roles_role")
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_user_roles_user")

  @@id([user_id, role_id])
  @@index([role_id], map: "fk_user_roles_role")
  @@map("user_roles")
}

model Permission {
  id               BigInt           @id @default(autoincrement())
  code             String           @unique(map: "uq_permissions_code") @db.VarChar(100)
  name             String           @db.VarChar(150)
  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       BigInt
  permission_id BigInt
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, map: "fk_role_permissions_permission")
  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade, map: "fk_role_permissions_role")

  @@id([role_id, permission_id])
  @@index([permission_id], map: "fk_role_permissions_permission")
  @@map("role_permissions")
}

model Participant {
  id                        BigInt                      @id @default(autoincrement())
  participant_number        String?                     @unique(map: "uq_participants_number") @db.VarChar(100)
  full_name                 String                      @db.VarChar(255)
  birth_place               String?                     @db.VarChar(100)
  birth_date                DateTime?                   @db.Date
  gender                    String?                     @db.VarChar(30)
  marital_status            String?                     @db.VarChar(50)
  phone                     String?                     @db.VarChar(50)
  email                     String?                     @db.VarChar(255)
  address                   String?                     @db.Text
  status                    String                      @default("ACTIVE") @db.VarChar(20)
  deleted_at                DateTime?                   @db.DateTime(0)
  created_at                DateTime                    @default(now()) @db.DateTime(0)
  updated_at                DateTime                    @default(now()) @updatedAt @db.DateTime(0)
  nik                       String?                     @db.VarChar(20)
  occupation                String?                     @db.VarChar(150)
  institution               String?                     @db.VarChar(255)
  attendances               Attendance[]
  batch_participants        BatchParticipant[]
  certificates              Certificate[]
  certification_results     CertificationResult[]
  exam_results              ExamResult[]
  notifications             Notification[]
  participant_registrations participant_registrations[]

  @@index([email], map: "idx_participants_email")
  @@map("participants")
}

model Instructor {
  id                  BigInt              @id @default(autoincrement())
  user_id             BigInt?
  full_name           String              @db.VarChar(255)
  email               String?             @db.VarChar(255)
  phone               String?             @db.VarChar(50)
  status              String              @default("ACTIVE") @db.VarChar(20)
  deleted_at          DateTime?           @db.DateTime(0)
  created_at          DateTime            @default(now()) @db.DateTime(0)
  updated_at          DateTime            @default(now()) @updatedAt @db.DateTime(0)
  user                User?               @relation(fields: [user_id], references: [id], map: "fk_instructors_user")
  session_instructors SessionInstructor[]

  @@index([email], map: "idx_instructors_email")
  @@index([user_id], map: "fk_instructors_user")
  @@map("instructors")
}

model Program {
  id                         BigInt                @id @default(autoincrement())
  code                       String                @unique(map: "uq_programs_code") @db.VarChar(50)
  name                       String                @db.VarChar(255)
  description                String?               @db.Text
  passing_grade              Decimal?              @db.Decimal(5, 2)
  minimum_attendance_percent Decimal?              @db.Decimal(5, 2)
  status                     String                @default("ACTIVE") @db.VarChar(20)
  deleted_at                 DateTime?             @db.DateTime(0)
  created_at                 DateTime              @default(now()) @db.DateTime(0)
  updated_at                 DateTime              @default(now()) @updatedAt @db.DateTime(0)
  requirements               String?               @db.Text
  batches                    Batch[]
  exams                      Exam[]
  program_form_fields        program_form_fields[]
  program_modules            ProgramModule[]

  @@map("programs")
}

model Module {
  id              BigInt          @id @default(autoincrement())
  code            String          @unique(map: "uq_modules_code") @db.VarChar(50)
  name            String          @db.VarChar(255)
  description     String?         @db.Text
  status          String          @default("ACTIVE") @db.VarChar(20)
  deleted_at      DateTime?       @db.DateTime(0)
  created_at      DateTime        @default(now()) @db.DateTime(0)
  updated_at      DateTime        @default(now()) @updatedAt @db.DateTime(0)
  program_modules ProgramModule[]
  sessions        Session[]

  @@map("modules")
}

model ProgramModule {
  program_id  BigInt
  module_id   BigInt
  sequence_no Int?
  module      Module  @relation(fields: [module_id], references: [id], map: "fk_program_modules_module")
  program     Program @relation(fields: [program_id], references: [id], map: "fk_program_modules_program")

  @@id([program_id, module_id])
  @@index([module_id], map: "fk_program_modules_module")
  @@map("program_modules")
}

model Batch {
  id                        BigInt                      @id @default(autoincrement())
  program_id                BigInt
  code                      String                      @db.VarChar(100)
  name                      String                      @db.VarChar(255)
  start_date                DateTime?                   @db.Date
  end_date                  DateTime?                   @db.Date
  status                    String                      @default("PLANNED") @db.VarChar(20)
  deleted_at                DateTime?                   @db.DateTime(0)
  created_at                DateTime                    @default(now()) @db.DateTime(0)
  updated_at                DateTime                    @default(now()) @updatedAt @db.DateTime(0)
  registration_fee          Decimal?                    @default(0.00) @db.Decimal(10, 2)
  batch_participants        BatchParticipant[]
  program                   Program                     @relation(fields: [program_id], references: [id], map: "fk_batches_program")
  certification_results     CertificationResult[]
  participant_registrations participant_registrations[]
  sessions                  Session[]

  @@unique([program_id, code], map: "uq_batches_program_code")
  @@map("batches")
}

model BatchParticipant {
  id             BigInt      @id @default(autoincrement())
  batch_id       BigInt
  participant_id BigInt
  status         String      @default("ENROLLED") @db.VarChar(20)
  enrolled_at    DateTime    @default(now()) @db.DateTime(0)
  batch          Batch       @relation(fields: [batch_id], references: [id], map: "fk_batch_participants_batch")
  participant    Participant @relation(fields: [participant_id], references: [id], map: "fk_batch_participants_participant")

  @@unique([batch_id, participant_id], map: "uq_batch_participant")
  @@index([participant_id], map: "fk_batch_participants_participant")
  @@map("batch_participants")
}

model Room {
  id         BigInt    @id @default(autoincrement())
  code       String    @unique(map: "uq_rooms_code") @db.VarChar(50)
  name       String    @db.VarChar(255)
  capacity   Int?
  location   String?   @db.VarChar(255)
  status     String    @default("ACTIVE") @db.VarChar(20)
  deleted_at DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.DateTime(0)
  updated_at DateTime  @default(now()) @updatedAt @db.DateTime(0)
  sessions   Session[]

  @@map("rooms")
}

model Session {
  id                  BigInt              @id @default(autoincrement())
  batch_id            BigInt
  module_id           BigInt?
  room_id             BigInt?
  title               String              @db.VarChar(255)
  session_date        DateTime            @db.Date
  start_time          String              @db.VarChar(20)
  end_time            String              @db.VarChar(20)
  status              String              @default("SCHEDULED") @db.VarChar(20)
  created_at          DateTime            @default(now()) @db.DateTime(0)
  updated_at          DateTime            @default(now()) @updatedAt @db.DateTime(0)
  attendances         Attendance[]
  session_instructors SessionInstructor[]
  batch               Batch               @relation(fields: [batch_id], references: [id], map: "fk_sessions_batch")
  module              Module?             @relation(fields: [module_id], references: [id], map: "fk_sessions_module")
  room                Room?               @relation(fields: [room_id], references: [id], map: "fk_sessions_room")

  @@index([session_date, start_time, end_time], map: "idx_sessions_schedule")
  @@index([batch_id], map: "fk_sessions_batch")
  @@index([module_id], map: "fk_sessions_module")
  @@index([room_id], map: "fk_sessions_room")
  @@map("sessions")
}

model SessionInstructor {
  session_id    BigInt
  instructor_id BigInt
  instructor    Instructor @relation(fields: [instructor_id], references: [id], map: "fk_session_instructors_instructor")
  session       Session    @relation(fields: [session_id], references: [id], map: "fk_session_instructors_session")

  @@id([session_id, instructor_id])
  @@index([instructor_id], map: "fk_session_instructors_instructor")
  @@map("session_instructors")
}

model Attendance {
  id             BigInt      @id @default(autoincrement())
  session_id     BigInt
  participant_id BigInt
  status         String      @db.VarChar(20)
  notes          String?     @db.VarChar(500)
  recorded_by    BigInt?
  recorded_at    DateTime    @default(now()) @db.DateTime(0)
  participant    Participant @relation(fields: [participant_id], references: [id], map: "fk_attendance_participant")
  recorder       User?       @relation(fields: [recorded_by], references: [id], map: "fk_attendance_recorder")
  session        Session     @relation(fields: [session_id], references: [id], map: "fk_attendance_session")

  @@unique([session_id, participant_id], map: "uq_attendance_session_participant")
  @@index([participant_id], map: "fk_attendance_participant")
  @@index([recorded_by], map: "fk_attendance_recorder")
  @@map("attendance")
}

model Exam {
  id            BigInt       @id @default(autoincrement())
  program_id    BigInt?
  code          String       @unique(map: "uq_exams_code") @db.VarChar(100)
  name          String       @db.VarChar(255)
  type          String       @default("OTHER") @db.VarChar(50)
  passing_grade Decimal?     @db.Decimal(5, 2)
  created_at    DateTime     @default(now()) @db.DateTime(0)
  updated_at    DateTime     @default(now()) @updatedAt @db.DateTime(0)
  exam_results  ExamResult[]
  program       Program?     @relation(fields: [program_id], references: [id], map: "fk_exams_program")

  @@index([program_id], map: "fk_exams_program")
  @@map("exams")
}

model ExamResult {
  id             BigInt      @id @default(autoincrement())
  exam_id        BigInt
  participant_id BigInt
  score          Decimal?    @db.Decimal(7, 2)
  status         String      @default("PENDING") @db.VarChar(20)
  exam_date      DateTime?   @db.Date
  notes          String?     @db.Text
  created_at     DateTime    @default(now()) @db.DateTime(0)
  updated_at     DateTime    @default(now()) @updatedAt @db.DateTime(0)
  exam           Exam        @relation(fields: [exam_id], references: [id], map: "fk_exam_results_exam")
  participant    Participant @relation(fields: [participant_id], references: [id], map: "fk_exam_results_participant")

  @@unique([exam_id, participant_id], map: "uq_exam_result")
  @@index([participant_id], map: "fk_exam_results_participant")
  @@map("exam_results")
}

model CertificationResult {
  id             BigInt      @id @default(autoincrement())
  participant_id BigInt
  batch_id       BigInt?
  stage          String      @db.VarChar(50)
  status         String      @default("PENDING") @db.VarChar(20)
  decision_date  DateTime?   @db.Date
  notes          String?     @db.Text
  created_at     DateTime    @default(now()) @db.DateTime(0)
  updated_at     DateTime    @default(now()) @updatedAt @db.DateTime(0)
  batch          Batch?      @relation(fields: [batch_id], references: [id], map: "fk_cert_results_batch")
  participant    Participant @relation(fields: [participant_id], references: [id], map: "fk_cert_results_participant")

  @@index([participant_id], map: "idx_cert_results_participant")
  @@index([batch_id], map: "fk_cert_results_batch")
  @@map("certification_results")
}

model Certificate {
  id                 BigInt      @id @default(autoincrement())
  participant_id     BigInt
  certificate_number String      @unique(map: "uq_certificates_number") @db.VarChar(150)
  verification_code  String      @unique(map: "uq_certificates_verification") @db.VarChar(150)
  issue_date         DateTime    @db.Date
  expiry_date        DateTime?   @db.Date
  status             String      @default("VALID") @db.VarChar(20)
  file_path          String?     @db.VarChar(500)
  qr_payload         String?     @db.VarChar(500)
  revoked_at         DateTime?   @db.DateTime(0)
  created_at         DateTime    @default(now()) @db.DateTime(0)
  updated_at         DateTime    @default(now()) @updatedAt @db.DateTime(0)
  participant        Participant @relation(fields: [participant_id], references: [id], map: "fk_certificates_participant")

  @@index([participant_id], map: "fk_certificates_participant")
  @@map("certificates")
}

model Notification {
  id             BigInt              @id @default(autoincrement())
  user_id        BigInt?
  participant_id BigInt?
  channel        String              @db.VarChar(20)
  subject        String?             @db.VarChar(255)
  message        String              @db.Text
  status         String              @default("PENDING") @db.VarChar(20)
  sent_at        DateTime?           @db.DateTime(0)
  created_at     DateTime            @default(now()) @db.DateTime(0)
  queue          NotificationQueue[]
  participant    Participant?        @relation(fields: [participant_id], references: [id], map: "fk_notifications_participant")
  user           User?               @relation(fields: [user_id], references: [id], map: "fk_notifications_user")

  @@index([participant_id], map: "fk_notifications_participant")
  @@index([user_id], map: "fk_notifications_user")
  @@map("notifications")
}

model NotificationQueue {
  id              BigInt       @id @default(autoincrement())
  notification_id BigInt
  status          String       @default("PENDING") @db.VarChar(20)
  attempt_count   Int          @default(0)
  scheduled_at    DateTime     @default(now()) @db.DateTime(0)
  sent_at         DateTime?    @db.DateTime(0)
  error_message   String?      @db.Text
  created_at      DateTime     @default(now()) @db.DateTime(0)
  updated_at      DateTime     @default(now()) @updatedAt @db.DateTime(0)
  notification    Notification @relation(fields: [notification_id], references: [id], map: "fk_notification_queue_notification")

  @@index([status, scheduled_at], map: "idx_notification_queue_status")
  @@index([notification_id], map: "fk_notification_queue_notification")
  @@map("notification_queue")
}

model ImportLog {
  id            BigInt   @id @default(autoincrement())
  source_type   String   @db.VarChar(50)
  source_name   String   @db.VarChar(255)
  status        String   @db.VarChar(20)
  total_rows    Int      @default(0)
  valid_rows    Int      @default(0)
  invalid_rows  Int      @default(0)
  error_summary String?  @db.Text
  created_by    BigInt?
  created_at    DateTime @default(now()) @db.DateTime(0)
  user          User?    @relation(fields: [created_by], references: [id], map: "fk_import_logs_user")

  @@index([created_by], map: "fk_import_logs_user")
  @@map("import_logs")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  user_id     BigInt?
  action      String   @db.VarChar(100)
  module      String   @db.VarChar(100)
  record_type String?  @db.VarChar(100)
  record_id   String?  @db.VarChar(100)
  before_data String?  @db.LongText
  after_data  String?  @db.LongText
  ip_address  String?  @db.VarChar(45)
  user_agent  String?  @db.VarChar(500)
  created_at  DateTime @default(now()) @db.DateTime(0)
  user        User?    @relation(fields: [user_id], references: [id], map: "fk_audit_logs_user")

  @@index([module, record_type, record_id], map: "idx_audit_module_record")
  @@index([created_at], map: "idx_audit_created_at")
  @@index([user_id], map: "fk_audit_logs_user")
  @@map("audit_logs")
}

model Banner {
  id          BigInt   @id @default(autoincrement())
  title       String   @db.VarChar(255)
  image_url   String   @db.VarChar(500)
  status      String   @default("PUBLISHED") @db.VarChar(20)
  created_at  DateTime @default(now()) @db.DateTime(0)
  updated_at  DateTime @default(now()) @updatedAt @db.DateTime(0)
  link_url    String?  @db.VarChar(500)
  sequence_no Int?     @default(0)

  @@map("cms_banners")
}

model Partner {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(255)
  logo_url    String   @db.VarChar(500)
  status      String   @default("PUBLISHED") @db.VarChar(20)
  created_at  DateTime @default(now()) @db.DateTime(0)
  sequence_no Int?     @default(0)
  updated_at  DateTime @default(now()) @updatedAt @db.DateTime(0)
  website_url String?  @db.VarChar(500)

  @@map("cms_partners")
}

model News {
  id           BigInt    @id @default(autoincrement())
  title        String    @db.VarChar(255)
  slug         String?   @unique(map: "uq_news_slug") @db.VarChar(255)
  content      String    @db.LongText
  image_url    String?   @db.VarChar(500)
  status       String    @default("PUBLISHED") @db.VarChar(20)
  created_at   DateTime  @default(now()) @db.DateTime(0)
  updated_at   DateTime  @default(now()) @updatedAt @db.DateTime(0)
  published_at DateTime? @db.DateTime(0)

  @@map("cms_news")
}

model participant_form_answers {
  id                        BigInt                    @id @default(autoincrement())
  registration_id           BigInt
  field_id                  BigInt
  answer_text               String?                   @db.Text
  file_url                  String?                   @db.VarChar(255)
  program_form_fields       program_form_fields       @relation(fields: [field_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_participant_form_answers_field")
  participant_registrations participant_registrations @relation(fields: [registration_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_participant_form_answers_registration")

  @@index([field_id], map: "fk_participant_form_answers_field")
  @@index([registration_id], map: "fk_participant_form_answers_registration")
}

model participant_registrations {
  id                       BigInt                     @id @default(autoincrement())
  participant_id           BigInt
  batch_id                 BigInt
  status                   String                     @default("PENDING_PAYMENT") @db.VarChar(50)
  total_amount             Decimal                    @default(0.00) @db.Decimal(10, 2)
  payment_proof_url        String?                    @db.VarChar(255)
  payment_deadline         DateTime?                  @db.DateTime(0)
  submitted_at             DateTime                   @default(now()) @db.DateTime(0)
  reviewed_at              DateTime?                  @db.DateTime(0)
  reviewed_by              BigInt?
  notes                    String?                    @db.Text
  created_at               DateTime                   @default(now()) @db.DateTime(0)
  updated_at               DateTime                   @default(now()) @db.DateTime(0)
  participant_form_answers participant_form_answers[]
  batches                  Batch                      @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_participant_registrations_batch")
  participants             Participant                @relation(fields: [participant_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_participant_registrations_participant")
  users                    User?                      @relation(fields: [reviewed_by], references: [id], onUpdate: Restrict, map: "fk_participant_registrations_reviewed_by")

  @@index([batch_id], map: "fk_participant_registrations_batch")
  @@index([participant_id], map: "fk_participant_registrations_participant")
  @@index([reviewed_by], map: "fk_participant_registrations_reviewed_by")
}

model program_form_fields {
  id                       BigInt                     @id @default(autoincrement())
  program_id               BigInt
  label                    String                     @db.VarChar(255)
  field_type               String                     @default("TEXT") @db.VarChar(50)
  options_json             String?                    @db.Text
  is_required              Boolean?                   @default(false)
  allowed_extensions       String?                    @db.VarChar(255)
  order_index              Int?                       @default(0)
  participant_form_answers participant_form_answers[]
  programs                 Program                    @relation(fields: [program_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_program_form_fields_program")

  @@index([program_id], map: "fk_program_form_fields_program")
}
