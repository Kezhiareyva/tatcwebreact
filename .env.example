# Shared local-development defaults (Laragon or XAMPP)
# Copy this file to .env, then adjust only values that differ on your machine.

# Vite development server
VITE_HOST=0.0.0.0
VITE_PORT=5173
# Internal target for Vite's /api proxy. This is not exposed to browser code.
VITE_BACKEND_TARGET=http://127.0.0.1:3001
# Keep empty when frontend and API are served through the same origin.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Docker Compose / production (dipakai docker-compose.yml)
# Isi di .env server. JANGAN commit nilai asli. Variabel bertanda (wajib)
# membuat `docker compose` berhenti dengan error bila kosong.
# ---------------------------------------------------------------------------

# Port host (dijangkau Caddy di 127.0.0.1) & port di dalam container
FRONTEND_PORT1=        # (wajib) harus sama dengan port di Caddyfile
FRONTEND_PORT2=        # (wajib) port `serve` di container frontend
BACKEND_PORT1=         # (wajib) harus sama dengan port di Caddyfile
BACKEND_PORT2=         # (wajib) port Next.js di container backend

# Database (MySQL container, tidak di-expose ke host)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_ROOT_PASS=

# phpMyAdmin (opt-in: docker compose --profile tools up -d phpmyadmin)
PMA_HOST=mysql
PMA_PORT1=3306
PMA_PORT2=             # (wajib, walau phpMyAdmin jarang dipakai) port tunnel di host
PMA_PORT3=80
PMA_UPLOAD_LIMIT=64M

# Aplikasi
SESSION_SECRET=        # minimal 32 karakter acak: openssl rand -base64 48
FRONTEND_URL=          # https://<domain frontend>
CORS_ORIGIN=           # https://<domain frontend>

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
