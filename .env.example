# ==============================================================================
# TATC WEB PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env` dan sesuaikan nilainya untuk lingkungan Anda
# (Local Development / Docker / Server VPS).

# ------------------------------------------------------------------------------
# 1. DOMAIN & WEB URLS (Sesuaikan untuk Lokal vs VPS)
# ------------------------------------------------------------------------------
# Untuk Lokal Dev: http://localhost:5173 (atau port Vite Anda)
# Untuk VPS Production: https://tatc.yourdomain.com
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. BINDING IP ADDRESSES & PORTS (Lokal vs VPS)
# ------------------------------------------------------------------------------
# BIND_IP: Gunakan 0.0.0.0 agar dapat diakses dari luar container/server,
# atau 127.0.0.1 agar hanya dapat diakses internal/loopback di host server.
FRONTEND_BIND_IP=0.0.0.0
FRONTEND_PORT=3000

BACKEND_BIND_IP=0.0.0.0
BACKEND_PORT=3001

# Disarankan bind ke 127.0.0.1 agar database & phpMyAdmin tidak terbuka bebas ke internet publik
DB_BIND_IP=127.0.0.1
DB_PORT=3306

PMA_BIND_IP=127.0.0.1
PMA_PORT=5050
PMA_UPLOAD_LIMIT=64M

# ------------------------------------------------------------------------------
# 3. VITE LOCAL DEVELOPMENT (Digunakan saat `npm run dev`)
# ------------------------------------------------------------------------------
VITE_HOST=0.0.0.0
VITE_PORT=5173
VITE_BACKEND_TARGET=http://localhost:3001

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_NAME=tatc_web
DB_USER=tatc_user
DB_PASS=tatc_password
DB_ROOT_PASS=rootpassword

# Prisma / Connection String (Format MySQL)
# Lokal: mysql://root:@127.0.0.1:3306/tatc_web
# Docker: mysql://tatc_user:tatc_password@mysql:3306/tatc_web
DATABASE_URL="mysql://tatc_user:tatc_password@127.0.0.1:3306/tatc_web"

# ------------------------------------------------------------------------------
# 5. KEAMANAN & AUTENTIKASI
# ------------------------------------------------------------------------------
# Gunakan string acak minimal 32 - 64 karakter
SESSION_SECRET="change_this_to_a_random_secure_secret_key_minimum_32_characters"

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL CONFIGURATION (NodeMailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="TATC Registration <your_email@gmail.com>"
